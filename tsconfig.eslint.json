{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "bin/**/*",
    "lib/**/*",
    "scripts/**/*",
    "__tests__/**/*",
    "templates/**/*.js",
    "**/*.js",
    "package.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.d.ts"
  ]
}